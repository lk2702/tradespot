"""
Baustein 3: Backtest der Auffälligkeiten aus scan.py.

Frage: Hatten die Auffälligkeiten in den letzten Jahren einen Vorsprung
gegenüber einem beliebigen Tag, auch nach Abzug von Handelskosten?

Ablauf je Auffälligkeit, getrennt nach Aktien / Krypto / Rohstoffe:
- Signal entsteht am Tagesschluss, Einstieg zum Eröffnungskurs des Folgetags
  (kein Blick in die Zukunft).
- Ausstieg nach 1, 3 oder 5 Handelstagen zum Schlusskurs.
- Kosten pro Trade (Gebühr + Spread + Slippage) werden abgezogen.
- Vergleich mit dem Durchschnitt ALLER Tage derselben Gruppe (Basis).
- Die t-Werte fassen Ereignisse desselben Tages zusammen, damit ein einzelner
  Crash mit 9 betroffenen Coins nicht 9-mal zählt.
- Stabilitätscheck: Der Vorsprung wird für die erste und die zweite
  Zeithälfte getrennt gezeigt. Echte Vorteile sollten in beiden sichtbar sein.

Aufruf:   python backtest.py

GRENZEN (bitte ernst nehmen):
- Überlebensverzerrung: Das Universum besteht aus HEUTIGEN Index-Mitgliedern und
  heutigen Top-Coins. Pleitegegangene oder aussortierte Werte fehlen, das macht
  Ergebnisse tendenziell zu gut. Der Vergleich mit der Basis mildert das ab.
- Viele Tests auf einmal: Einige Treffer entstehen allein durch Zufall. Deshalb
  zählt nur, was streng bestanden wird (siehe STRENG_T und beide Hälften).
- Kostenannahmen sind grob. Leihkosten für Leerverkäufe von Aktien sind nicht
  enthalten. Positionsgrößen sind nicht berücksichtigt.
- Vergangenheit garantiert nichts für die Zukunft.

Lernprojekt, keine Anlageberatung.
"""
from datetime import date
from pathlib import Path

import numpy as np
import pandas as pd

from daten_basis import verbinde
from scan import GAP_SCHWELLE, GAP_VOLUMEN, RSI_UEBERVERKAUFT, VOLUMEN_SPITZE

HORIZONTE = [1, 3, 5]                      # Handelstage ab Einstieg
KOSTEN = {"Aktien": 0.0010, "Krypto": 0.0020, "Rohstoffe": 0.0015}  # je Trade, Hin+Zurück
MIN_EREIGNISSE = 30
MIN_HAELFTE = 10
STRENG_T = 2.5
MIN_TAGE = 20

KLASSEN = ["Aktien", "Krypto", "Rohstoffe"]
CSV_DATEI = Path(__file__).with_name("backtest_ergebnisse.csv")

# (Anzeigename, Spalte, Richtung: +1 long, -1 short)
VARIANTEN = [
    ("Ausbruch nach oben -> long", "oben", 1),
    ("Überverkauft im Aufwärtstrend -> long", "ueber", 1),
    ("Ausbruch nach unten -> short (Trend folgt)", "unten", -1),
    ("Ausbruch nach unten -> long (Erholung)", "unten", 1),
    ("Kurslücke nach oben, hohes Volumen -> long", "gap_auf", 1),
    ("Kurslücke nach unten, hohes Volumen -> short", "gap_ab", -1),
    ("Kurslücke nach unten, hohes Volumen -> long (Erholung)", "gap_ab", 1),
]


# ---------- Daten und Kennzahlen ----------
def lade_kurse(con) -> tuple[pd.DataFrame, dict]:
    kurse = pd.read_sql_query(
        "SELECT k.ticker, k.datum, k.open, k.high, k.low, k.close, k.volume "
        "FROM kurse k JOIN universum u ON u.ticker = k.ticker "
        "WHERE u.liquide = 1 ORDER BY k.ticker, k.datum",
        con, parse_dates=["datum"],
    )
    kurse = kurse[kurse["datum"] < pd.Timestamp(date.today())]  # nur fertige Tageskerzen
    klasse_von = {}
    for ticker, gruppe in con.execute("SELECT ticker, gruppe FROM universum"):
        klasse_von[ticker] = {"KRYPTO": "Krypto", "ROHSTOFF": "Rohstoffe"}.get(gruppe, "Aktien")
    return kurse, klasse_von


def baue_tabelle(kurse: pd.DataFrame, klasse_von: dict) -> pd.DataFrame:
    teile = []
    for ticker, df in kurse.groupby("ticker"):
        df = df.sort_values("datum").dropna(subset=["close"]).reset_index(drop=True)
        if len(df) < 260:
            continue
        o, h, l, c, v = (df[x] for x in ("open", "high", "low", "close", "volume"))

        delta = c.diff()
        gewinn = delta.clip(lower=0).ewm(alpha=1 / 14, adjust=False).mean()
        verlust = (-delta.clip(upper=0)).ewm(alpha=1 / 14, adjust=False).mean()
        rsi = 100 - 100 / (1 + gewinn / verlust)

        hoch20 = h.shift(1).rolling(20).max()
        tief20 = l.shift(1).rolling(20).min()
        vs = v.shift(1).rolling(20).mean()
        vr = v / vs.where(vs > 0)
        sma50 = c.rolling(50).mean()
        sma200 = c.rolling(200).mean()
        gap = o / c.shift(1) - 1
        gap_gross = (gap.abs() >= GAP_SCHWELLE) & (vr >= GAP_VOLUMEN)

        t = pd.DataFrame({"datum": df["datum"], "ticker": ticker, "klasse": klasse_von[ticker]})
        t["oben"] = (c > hoch20) & (vr >= VOLUMEN_SPITZE) & (c > sma50)
        t["ueber"] = (rsi < RSI_UEBERVERKAUFT) & (c > sma200)
        t["unten"] = (c < tief20) & (vr >= VOLUMEN_SPITZE) & (c <= sma50)
        t["gap_auf"] = gap_gross & (gap > 0)
        t["gap_ab"] = gap_gross & (gap < 0)

        einstieg = o.shift(-1)  # Eröffnungskurs des Folgetags
        for hz in HORIZONTE:
            t[f"fwd{hz}"] = c.shift(-hz) / einstieg - 1
        teile.append(t[sma200.notna()])
    return pd.concat(teile, ignore_index=True)


# ---------- Auswertung ----------
def kennzahlen(g_alle, ev, col, richtung, kosten, mitte) -> dict | None:
    ev = ev.dropna(subset=[col])
    g = g_alle.dropna(subset=[col])
    if len(ev) < MIN_EREIGNISSE:
        return None

    roh = richtung * ev[col]
    netto = roh - kosten
    basis = (richtung * g[col]).mean()
    vorsprung = roh.mean() - basis

    pro_tag = (roh - basis).groupby(ev["datum"]).mean()  # Cluster: ein Wert je Tag
    sd = pro_tag.std(ddof=1)
    t = pro_tag.mean() / (sd / np.sqrt(len(pro_tag))) if len(pro_tag) > 2 and sd > 0 else np.nan

    def haelfte(spalte_ev, spalte_g):
        e = ev[spalte_ev]
        b = g[spalte_g]
        if len(e) < MIN_HAELFTE or b.empty:
            return np.nan
        return richtung * e[col].mean() - (richtung * b[col]).mean()

    return {
        "n": len(ev),
        "tage": ev["datum"].nunique(),
        "mean_netto": netto.mean(),
        "median_netto": netto.median(),
        "treffer": (netto > 0).mean(),
        "fall5": netto.quantile(0.05),
        "vorsprung": vorsprung,
        "t": t,
        "v_h1": haelfte(ev["datum"] <= mitte, g["datum"] <= mitte),
        "v_h2": haelfte(ev["datum"] > mitte, g["datum"] > mitte),
    }


def analysiere(alle: pd.DataFrame) -> pd.DataFrame:
    mitte = alle["datum"].sort_values().iloc[len(alle) // 2]
    zeilen = []
    for klasse in KLASSEN:
        teil = alle[alle["klasse"] == klasse]
        if teil.empty:
            continue
        for name, spalte, richtung in VARIANTEN:
            ev = teil[teil[spalte]]
            for hz in HORIZONTE:
                k = kennzahlen(teil, ev, f"fwd{hz}", richtung, KOSTEN[klasse], mitte)
                if k:
                    zeilen.append({"klasse": klasse, "variante": name, "h": hz, **k})
    return pd.DataFrame(zeilen)


def streng_bestanden(z) -> bool:
    return bool(
        z["n"] >= MIN_EREIGNISSE and z["tage"] >= MIN_TAGE
        and z["mean_netto"] > 0 and z["vorsprung"] > 0
        and z["t"] >= STRENG_T and z["v_h1"] > 0 and z["v_h2"] > 0
    )


def zeige(erg: pd.DataFrame, alle: pd.DataFrame) -> None:
    print(f"Zeitraum: {alle['datum'].min().date()} bis {alle['datum'].max().date()} | "
          f"Werte: {alle['ticker'].nunique()} | Tageszeilen: {len(alle):,}".replace(",", "."))
    for klasse in KLASSEN:
        teil = erg[erg["klasse"] == klasse] if not erg.empty else erg
        if teil.empty:
            print(f"\n=== {klasse}: zu wenige Ereignisse für eine Aussage ===")
            continue
        print(f"\n=== {klasse} (angenommene Kosten {KOSTEN[klasse]:.2%} pro Trade) ===")
        for name, grp in teil.groupby("variante", sort=False):
            print(f"\n{name}")
            print("  Halte  Ereign.  Tage  Ø netto  Median  Treffer  5%-Fall  Vorsprung     t  1.Hälfte  2.Hälfte")
            for _, z in grp.iterrows():
                print(f"  {z['h']:>2} T  {z['n']:>7} {z['tage']:>5} {z['mean_netto']:>8.2%} "
                      f"{z['median_netto']:>7.2%} {z['treffer']:>7.0%} {z['fall5']:>8.2%} "
                      f"{z['vorsprung']:>9.2%} {z['t']:>5.1f} {z['v_h1']:>8.2%} {z['v_h2']:>8.2%}")

    print("\n" + "=" * 60)
    print("Strenger Test (Ø netto > 0, Vorsprung > 0, t >= "
          f"{STRENG_T}, in BEIDEN Zeithälften positiv):")
    if erg.empty:
        print("  Keine auswertbaren Ergebnisse.")
        return
    bestanden = erg[erg.apply(streng_bestanden, axis=1)]
    if bestanden.empty:
        print("  Keine Variante besteht den Test. Das ist ein ehrliches Ergebnis:\n"
              "  Die Auffälligkeiten allein hatten hier keinen verlässlichen Vorsprung.")
    else:
        for _, z in bestanden.iterrows():
            print(f"  {z['klasse']}: {z['variante']}, Haltedauer {z['h']} T "
                  f"(Vorsprung {z['vorsprung']:+.2%}, t {z['t']:.1f}, n {z['n']})")
        print("  Auch das ist nur ein Hinweis, kein Beweis (Zufall, Überlebensverzerrung).")


def main() -> None:
    con = verbinde()
    kurse, klasse_von = lade_kurse(con)
    con.close()
    print("Berechne Kennzahlen für alle Werte ...")
    alle = baue_tabelle(kurse, klasse_von)
    erg = analysiere(alle)
    zeige(erg, alle)
    if not erg.empty:
        erg.to_csv(CSV_DATEI, index=False, sep=";", decimal=",", encoding="utf-8-sig")
        print(f"\nGespeichert: {CSV_DATEI.name}. Keine Anlageberatung.")


if __name__ == "__main__":
    main()

"""
Baustein 1: Universum und lokale Kursdatenbank (kostenlos, nur Tagesdaten).

Installation:  pip install yfinance pandas lxml

Befehle:
    python daten_basis.py init     Universum aufbauen + erste Kursdaten laden
    python daten_basis.py update   neue Kurse nachladen (am besten nach Börsenschluss)
    python daten_basis.py status   Überblick über die Datenbank

Die Daten landen in kurse.db (im selben Ordner). Spätere Bausteine lesen
von dort, statt jedes Mal alles neu zu laden.

Hinweise:
- Ein Tageskerzen-Eintrag von heute kann unvollständig sein, solange die Börse
  offen ist. Beim nächsten update wird er automatisch überschrieben.
- Datenquelle yfinance ist kostenlos, aber inoffiziell und kann Lücken haben.

Lernprojekt, keine Anlageberatung.
"""
import io
import sqlite3
import ssl
import sys
import time
import urllib.request
from datetime import date, timedelta
from pathlib import Path

import certifi
import pandas as pd
import yfinance as yf

DB_DATEI = Path(__file__).with_name("kurse.db")
HISTORIE_JAHRE = 5
MIN_UMSATZ = 5_000_000  # durchschnittlicher Tagesumsatz (20 Tage) für Aktien

# Wikipedia-Listen: (Gruppe, URL)
AKTIEN_QUELLEN = [
    ("SP500", "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"),
    ("NDX", "https://en.wikipedia.org/wiki/Nasdaq-100"),
    ("DAX", "https://en.wikipedia.org/wiki/DAX"),
]

NOTFALL_AKTIEN = [
    "AAPL", "MSFT", "NVDA", "AMZN", "GOOGL", "META", "TSLA", "JPM", "XOM", "SAP.DE",
]

KRYPTO = {
    "BTC-USD": "Bitcoin", "ETH-USD": "Ethereum", "BNB-USD": "BNB",
    "XRP-USD": "XRP", "SOL-USD": "Solana", "ADA-USD": "Cardano",
    "DOGE-USD": "Dogecoin", "TRX-USD": "TRON", "AVAX-USD": "Avalanche",
    "LINK-USD": "Chainlink", "DOT-USD": "Polkadot", "LTC-USD": "Litecoin",
    "BCH-USD": "Bitcoin Cash", "XLM-USD": "Stellar", "ATOM-USD": "Cosmos",
}

ROHSTOFFE = {
    "GC=F": "Gold", "SI=F": "Silber", "PL=F": "Platin", "HG=F": "Kupfer",
    "CL=F": "Öl (WTI)", "BZ=F": "Öl (Brent)", "NG=F": "Erdgas",
    "ZW=F": "Weizen", "ZC=F": "Mais", "ZS=F": "Sojabohnen",
    "KC=F": "Kaffee", "SB=F": "Zucker", "CT=F": "Baumwolle",
}


# ---------- Datenbank ----------
def verbinde() -> sqlite3.Connection:
    con = sqlite3.connect(DB_DATEI)
    con.execute(
        "CREATE TABLE IF NOT EXISTS universum ("
        "ticker TEXT PRIMARY KEY, name TEXT, gruppe TEXT, liquide INTEGER DEFAULT 1)"
    )
    con.execute(
        "CREATE TABLE IF NOT EXISTS kurse ("
        "ticker TEXT, datum TEXT, open REAL, high REAL, low REAL, close REAL, "
        "volume REAL, PRIMARY KEY (ticker, datum))"
    )
    return con


def lade_kurse(ticker: str, con: sqlite3.Connection | None = None) -> pd.DataFrame:
    """Für spätere Bausteine: Kurse eines Werts als DataFrame (Index = Datum)."""
    eigene = con is None
    con = con or verbinde()
    df = pd.read_sql_query(
        "SELECT datum, open AS Open, high AS High, low AS Low, close AS Close, "
        "volume AS Volume FROM kurse WHERE ticker = ? ORDER BY datum",
        con, params=(ticker,), parse_dates=["datum"], index_col="datum",
    )
    if eigene:
        con.close()
    return df


# ---------- Universum ----------
def _wiki_liste(url: str, gruppe: str) -> list[tuple[str, str]]:
    anfrage = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (trading-basis)"})
    kontext = ssl.create_default_context(cafile=certifi.where())
    html = urllib.request.urlopen(anfrage, timeout=30, context=kontext).read().decode("utf-8")
    for tab in pd.read_html(io.StringIO(html)):
        tab.columns = [c[0] if isinstance(c, tuple) else c for c in tab.columns]
        spalten = {str(c).strip().lower(): c for c in tab.columns}
        sym = next((c for k, c in spalten.items() if "ticker" in k or "symbol" in k), None)
        nam = next(
            (c for k, c in spalten.items() if "company" in k or "security" in k or k == "name"),
            None,
        )
        if sym is None or len(tab) < 20:
            continue
        ergebnis = []
        for _, zeile in tab.iterrows():
            t = str(zeile[sym]).strip()
            if ":" in t:
                t = t.split(":")[-1].strip()
            if not t or t.lower() == "nan":
                continue
            if gruppe == "DAX":
                if "." not in t:  # z. B. ADS -> ADS.DE, AIR.PA bleibt AIR.PA
                    t += ".DE"
            else:
                t = t.replace(".", "-")  # z. B. BRK.B -> BRK-B
            ergebnis.append((t, str(zeile[nam]) if nam is not None else t))
        return ergebnis
    raise ValueError("keine passende Tabelle gefunden")


def baue_universum(con: sqlite3.Connection) -> None:
    eintraege: dict[str, tuple[str, str]] = {}
    for gruppe, url in AKTIEN_QUELLEN:
        try:
            liste = _wiki_liste(url, gruppe)
            print(f"  {gruppe}: {len(liste)} Werte gefunden")
            for ticker, name in liste:
                eintraege.setdefault(ticker, (name, gruppe))
        except Exception as fehler:
            print(f"  Warnung: {gruppe}-Liste konnte nicht geladen werden "
                  f"[{type(fehler).__name__}: {fehler}]")

    if not eintraege:
        print("  Keine Aktienlisten verfügbar, nutze kleine Notfall-Liste.")
        for ticker in NOTFALL_AKTIEN:
            eintraege[ticker] = (ticker, "NOTFALL")

    for ticker, name in KRYPTO.items():
        eintraege[ticker] = (name, "KRYPTO")
    for ticker, name in ROHSTOFFE.items():
        eintraege[ticker] = (name, "ROHSTOFF")

    con.execute("DELETE FROM universum")
    con.executemany(
        "INSERT INTO universum (ticker, name, gruppe) VALUES (?, ?, ?)",
        [(t, n, g) for t, (n, g) in eintraege.items()],
    )
    con.commit()
    print(f"Universum: {len(eintraege)} Werte insgesamt.")


# ---------- Kurse laden ----------
def _zerlege(df: pd.DataFrame, tickers: list[str]) -> dict[str, pd.DataFrame]:
    ergebnis: dict[str, pd.DataFrame] = {}
    if df is None or df.empty:
        return ergebnis
    if isinstance(df.columns, pd.MultiIndex):
        if "Close" in df.columns.get_level_values(0):  # Felder oben (ein Wert)
            einzeln = df.copy()
            einzeln.columns = einzeln.columns.get_level_values(0)
            ergebnis[tickers[0]] = einzeln.dropna(how="all")
        else:
            vorhanden = set(df.columns.get_level_values(0))
            for t in tickers:
                if t in vorhanden:
                    teil = df[t].dropna(how="all")
                    if not teil.empty:
                        ergebnis[t] = teil
    else:
        ergebnis[tickers[0]] = df.dropna(how="all")
    return ergebnis


def _speichere(con: sqlite3.Connection, ticker: str, df: pd.DataFrame) -> None:
    df = df.dropna(subset=["Close"])
    if df.empty:
        return
    idx = pd.DatetimeIndex(df.index).tz_localize(None)
    zeilen = [
        (ticker, d.strftime("%Y-%m-%d"), float(o), float(h), float(l), float(c), float(v))
        for d, o, h, l, c, v in zip(
            idx, df["Open"], df["High"], df["Low"], df["Close"], df["Volume"]
        )
    ]
    con.executemany(
        "INSERT OR REPLACE INTO kurse (ticker, datum, open, high, low, close, volume) "
        "VALUES (?, ?, ?, ?, ?, ?, ?)",
        zeilen,
    )


def _anpassung_geaendert(con: sqlite3.Connection, ticker: str, df: pd.DataFrame,
                         letzte_datum: str) -> bool:
    """Prüft, ob sich bereits gespeicherte Kurse rückwirkend verändert haben
    (Aktiensplit oder Dividende). Dann muss die Historie neu geladen werden,
    sonst entstehen künstliche Kurslücken in den Daten."""
    idx = pd.DatetimeIndex(df.index).tz_localize(None).strftime("%Y-%m-%d")
    neu = pd.Series(df["Close"].values, index=idx)
    grenze = (date.fromisoformat(letzte_datum) - timedelta(days=3)).isoformat()
    ab = idx.min()
    gespeichert = con.execute(
        "SELECT datum, close FROM kurse WHERE ticker = ? AND datum >= ? AND datum <= ?",
        (ticker, ab, grenze),
    ).fetchall()
    for datum, close_alt in gespeichert:
        close_neu = neu.get(datum)
        if (close_neu is not None and pd.notna(close_neu) and close_alt
                and abs(close_neu / close_alt - 1) > 0.001):
            return True
    return False


def _lade_batches(con: sqlite3.Connection, tickers: list[str], start: date,
                  batch: int = 50, letzte: dict | None = None) -> list[str]:
    geaendert: list[str] = []
    for i in range(0, len(tickers), batch):
        teil = tickers[i:i + batch]
        print(f"  Lade Werte {i + 1}-{i + len(teil)} von {len(tickers)} ...")
        try:
            df = yf.download(
                teil, start=start.isoformat(), auto_adjust=True,
                group_by="ticker", threads=True, progress=False,
            )
        except Exception as fehler:
            print(f"  Fehler bei diesem Paket: {fehler}")
            continue
        for ticker, daten in _zerlege(df, teil).items():
            if letzte and ticker in letzte and _anpassung_geaendert(
                    con, ticker, daten, letzte[ticker]):
                geaendert.append(ticker)
            _speichere(con, ticker, daten)
        con.commit()
        time.sleep(1)  # freundlich zur Datenquelle
    return geaendert


def aktualisiere(con: sqlite3.Connection) -> None:
    tickers = [r[0] for r in con.execute("SELECT ticker FROM universum")]
    letzte = dict(con.execute(
        "SELECT ticker, MAX(datum) FROM kurse GROUP BY ticker").fetchall())
    neu = [t for t in tickers if t not in letzte]
    alt = [t for t in tickers if t in letzte]
    heute = date.today()

    if neu:
        print(f"Volle Historie für {len(neu)} Werte ({HISTORIE_JAHRE} Jahre) ...")
        _lade_batches(con, neu, heute - timedelta(days=365 * HISTORIE_JAHRE))
    if alt:
        start = min(date.fromisoformat(letzte[t]) for t in alt) - timedelta(days=10)
        print(f"Update für {len(alt)} Werte ab {start} ...")
        geaendert = _lade_batches(con, alt, start, letzte=letzte)
        if geaendert:
            print(f"Kursanpassung (Split/Dividende) bei {len(geaendert)} Werten erkannt, "
                  "lade deren Historie komplett neu ...")
            _lade_batches(con, geaendert, heute - timedelta(days=365 * HISTORIE_JAHRE))


# ---------- Liquidität und Status ----------
def berechne_liquiditaet(con: sqlite3.Connection) -> None:
    """Aktien mit zu wenig Tagesumsatz werden als nicht liquide markiert."""
    for ticker, gruppe in con.execute("SELECT ticker, gruppe FROM universum").fetchall():
        if gruppe in ("KRYPTO", "ROHSTOFF"):
            liquide = 1
        else:
            zeilen = con.execute(
                "SELECT close, volume FROM kurse WHERE ticker = ? "
                "ORDER BY datum DESC LIMIT 20", (ticker,)).fetchall()
            umsaetze = [c * v for c, v in zeilen if c is not None and v is not None]
            liquide = int(bool(umsaetze) and sum(umsaetze) / len(umsaetze) >= MIN_UMSATZ)
        con.execute("UPDATE universum SET liquide = ? WHERE ticker = ?", (liquide, ticker))
    con.commit()


def status(con: sqlite3.Connection) -> None:
    print("\nGruppe      Werte   liquide")
    for gruppe, n, l in con.execute(
            "SELECT gruppe, COUNT(*), SUM(liquide) FROM universum GROUP BY gruppe"):
        print(f"{gruppe:<10} {n:>6} {l or 0:>9}")
    n_kurse, anzahl, letzte = con.execute(
        "SELECT COUNT(*), COUNT(DISTINCT ticker), MAX(datum) FROM kurse").fetchone()
    print(f"\nKurszeilen: {n_kurse} | Werte mit Daten: {anzahl} | neuester Tag: {letzte}")
    ohne = [r[0] for r in con.execute(
        "SELECT ticker FROM universum WHERE ticker NOT IN (SELECT DISTINCT ticker FROM kurse)")]
    if ohne:
